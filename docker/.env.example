# Discord Bot Token (required)
# Get this from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Eleven Labs API Key (required)
# Get this from https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# OpenRouter API Key (required for AI features, optional if not using /prompt)
# Get this from https://openrouter.ai/
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Eleven Labs Voice ID
# Default is "Rachel" voice (21m00Tcm4TlvDq8ikWAM)
# Find voice IDs at https://api.elevenlabs.io/v1/voices
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Optional: OpenRouter LLM model
# See available models at https://openrouter.ai/models
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Optional: Default system prompt prepended to all AI requests
# OPENROUTER_DEFAULT_SYSTEM_PROMPT=Keep responses concise. Respond in character.

# Optional: Database provider (InMemory, Sqlite, or Postgres)
# Defaults to Sqlite in Docker for persistent storage
# DATABASE_PROVIDER=Sqlite
# DATABASE_CONNECTION_STRING=Data Source=data/erostts.db
