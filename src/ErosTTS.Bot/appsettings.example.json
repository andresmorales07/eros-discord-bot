{
  "Discord": {
    "Token": "YOUR_DISCORD_BOT_TOKEN",
    "DefaultTextChannelId": null,
    "DefaultVoiceChannelId": null,
    "MaxMessageLength": 500,
    "ProcessBotMessages": false,
    "EnableTextChannelMonitoring": false
  },
  "ElevenLabs": {
    "ApiKey": "YOUR_ELEVENLABS_API_KEY",
    "VoiceId": "21m00Tcm4TlvDq8ikWAM",
    "ModelId": "eleven_multilingual_v2",
    "OutputFormat": "mp3_44100_128",
    "Stability": 0.5,
    "SimilarityBoost": 0.75,
    "MaxRetries": 3,
    "TimeoutSeconds": 30
  },
  "Voice": {
    "FFmpegPath": "ffmpeg",
    "BitRate": 128,
    "BufferMilliseconds": 1000
  },
  "Queue": {
    "Capacity": 100
  },
  "OpenRouter": {
    "ApiKey": "YOUR_OPENROUTER_API_KEY",
    "Model": "anthropic/claude-3.5-sonnet",
    "MaxTokens": 500,
    "Temperature": 0.8,
    "TimeoutSeconds": 60,
    "MaxHistoryMessages": 20,
    "DefaultSystemPrompt": "Keep responses concise (under 2 sentences). Respond in character."
  },
  "Npc": {
    "MaxNpcsPerGuild": 20,
    "MaxHistoryMessages": 50,
    "AutoSwitchContextMessages": 5
  },
  "Database": {
    "Provider": "InMemory",
    "ConnectionString": "Data Source=data/erostts.db"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Discord": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  }
